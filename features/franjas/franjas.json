        "amanecer": { "nombre": "Dawn", "anuncio": "Dawn breaks.", "estado": "It is dawn." },
        "dia": { "nombre": "Day", "anuncio": "The day begins.", "estado": "It is day." },
        "ocaso": { "nombre": "Dusk", "anuncio": "Dusk falls.", "estado": "It is dusk." },
        "noche": { "nombre": "Night", "anuncio": "Night falls.", "estado": "It is night." }
      }
    },
    "es": {
      "siguiente": "Después: {nombre} a las {hora}.",
      "franjas": {
        "amanecer": { "nombre": "Amanecer", "anuncio": "Amanece.", "estado": "Es el amanecer." },
        "dia": { "nombre": "Día", "anuncio": "Empieza el día.", "estado": "Es de día." },
        "ocaso": { "nombre": "Ocaso", "anuncio": "Atardece.", "estado": "Es el ocaso." },
        "noche": { "nombre": "Noche", "anuncio": "Cae la noche.", "estado": "Es de noche." }
      }
    }
  }
