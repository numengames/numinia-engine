    "nodos": {
      "bienvenida": {
        "texto": "Welcome to the stoa. As in the Painted Stoa of Athens, the artworks here hang under the columns, around a courtyard. Today almost every slot is waiting for its artist. Shall I show you the gallery?",
        "opciones": [
          {
            "texto": "Yes, show me.",
            "accion": {
              "tipo": "dar_mision",
              "mision": "primera-visita"
            },
            "ir": "recorrido"
          },
          {
            "texto": "Not now.",
            "accion": {
              "tipo": "despedir"
            }
          }
        ]
      },
      "recorrido": {
        "texto": "Go in, look into the fountain courtyard and find the critic in the north portico, next to the mural. He knows how to look.",
        "opciones": [
          {
            "texto": "On my way.",
            "accion": {
              "tipo": "despedir"
            }
          }
        ]
      },
      "visita": {
        "texto": "The courtyard is just past the door; the critic is at the far end, in the north portico. The mission book (key J) shows you the way.",
        "opciones": [
          {
            "texto": "Thank you.",
            "accion": {
              "tipo": "despedir"
            }
          }
        ]
      },
      "coleccion": {
        "texto": "Every artwork has its postcard. Bring me four, one from each wall: slot 3 in the west, 9 in the north, 17 in the east and 20 in the south. Whoever collects them goes into the book of patrons.",
        "opciones": [
          {
            "texto": "I will look for them.",
            "accion": {
              "tipo": "dar_mision",
              "mision": "coleccionista"
            }
          },
          {
            "texto": "Another day.",
            "accion": {
              "tipo": "despedir"
            }
          }
        ]
      },
      "buscando": {
        "texto": "Slots 3, 9, 17 and 20: one postcard on each wall. Come back when you have them.",
        "opciones": [
          {
            "texto": "Still looking.",
            "accion": {
              "tipo": "despedir"
            }
          }
        ]
      },
      "postales": {
        "texto": "Do you have them all? Let me see.",
        "opciones": [
          {
            "texto": "Here are my four postcards.",
