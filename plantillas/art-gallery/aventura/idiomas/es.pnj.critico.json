            }
          }
        ]
      },
      "encargo": {
        "texto": "Al entrar, todo el mundo mira hacia aquí, al mural. Casi nadie se da la vuelta. En la pared de la puerta, a la derecha según entras, hay un hueco grande: el 21. Ve, míralo de cerca y tráeme su postal.",
        "opciones": [
          {
            "texto": "Voy.",
            "accion": {
              "tipo": "dar_mision",
              "mision": "ojo-del-critico"
            }
          },
          {
            "texto": "Ahora no.",
            "accion": {
              "tipo": "despedir"
            }
          }
        ]
      },
      "mira": {
        "texto": "El hueco 21: en la pared de la puerta, a la derecha según entras. Míralo de cerca y trae su postal.",
        "opciones": [
          {
            "texto": "Voy.",
            "accion": {
              "tipo": "despedir"
            }
          }
        ]
      },
      "postal": {
        "texto": "¿La traes?",
        "opciones": [
          {
            "texto": "Aquí tienes la postal del hueco 21.",
            "si": {
              "mision": "ojo-del-critico",
              "estado": "activa",
              "paso": "entregar",
              "tiene": "postal-21"
            },
            "accion": {
