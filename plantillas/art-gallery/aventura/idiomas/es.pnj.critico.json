    "nodos": {
      "saludo": {
        "texto": "Ah, una visita. Antes de mirar una obra hay que mirar el sitio: asómate al patio de la fuente y vuelve. Luego te pongo a prueba el ojo.",
        "opciones": [
          {
            "texto": "Voy.",
            "accion": {
