              "mision": "ojo-del-critico"
            }
          },
          {
            "texto": "Todavía no.",
            "accion": {
              "tipo": "despedir"
            }
          }
        ]
      },
      "ojo": {
        "texto": "Buen ojo: has mirado donde nadie mira. Cuando lleguen las obras, ven a contarme qué ves.",
        "opciones": [
          {
            "texto": "Lo haré.",
            "accion": {
